# Copy to backend/.env and fill in. Real environment variables always override this file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/recruit
APP_ENV=development
# Required outside development (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3111
# S3 / MinIO (leave S3_ENDPOINT_URL empty for AWS)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=haken-resumes
# Email. console = print to the API log (dev). smtp = really send (production).
# FRONTEND_URL above is used to build the links in emails (verify, reset password) -> must be the public URL.
MAIL_BACKEND=console
MAIL_FROM=Haken Work <no-reply@your-domain.jp>
# Amazon SES (Tokyo): SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com, user/password = SES SMTP credentials
# SendGrid:           SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Who receives 'new employer inquiry' emails from the /employers form (comma-separated; empty = nobody).
ADMIN_NOTIFY_EMAIL=
